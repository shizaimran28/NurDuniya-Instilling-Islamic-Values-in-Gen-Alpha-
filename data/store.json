      "lessons": [
        {
          "id": "les_fatiha_keys",
          "madrasaId": "madrasa_noor_academy",
          "title": "The Seven Keys of Surah Al-Fatiha in Daily Salah",
          "titleUr": "روزانہ نماز میں سورۃ الفاتحہ کی سات کنجیاں",
          "subject": "quran",
          "ageGroup": "all",
          "content": "Surah Al-Fatiha is known as Umm al-Kitab (the Mother of the Book). Every day, we recite it at least 17 times in our obligatory prayers. In this lesson, we study why Allah begins with Ar-Rahman Ar-Rahim (The Entirely Merciful, The Especially Merciful) and how calling upon \"Ihdinas-Sirat al-Mustaqeem\" guides every decision we make in school and with friends.",
          "arabicVerse": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ",
          "transliteration": "Ihdinas-sirat al-mustaqeem",
          "translation": "Guide us to the Straight Path.",
          "audioScript": "Assalamu Alaikum dear students! In today’s lesson, Ustadh Farooq introduces the beauty of Surah Al-Fatiha. When you stand in prayer, remember you are speaking directly with your Creator. Asking for the Straight Path means asking for guidance in honesty, kindness, and knowledge.",
          "points": 50,
          "createdAt": "2026-10-05",
          "createdBy": "Ustadh Farooq Al-Azhari"
        },
        {
          "id": "les_sadiq_amin",
          "madrasaId": "madrasa_noor_academy",
          "title": "Character First: How the Prophet (SAW) Earned Al-Amin",
          "titleUr": "کردار کی عظمت: نبی کریم ﷺ کو الامین کا لقب کیسے ملا",
          "subject": "seerah",
          "ageGroup": "9-11",
          "content": "Even before receiving Revelation, everyone in Makkah trusted Prophet Muhammad (SAW) because he never uttered a single untruth. In your classroom, sports team, and family life, your honesty is your greatest light.",
          "arabicVerse": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ",
          "transliteration": "Wa innaka la‘ala khuluqin ‘adheem",
          "translation": "And indeed, you are of a great moral character.",
          "points": 40,
          "createdAt": "2026-10-06",
          "createdBy": "Ustadh Farooq Al-Azhari"
        },
        {
          "id": "les_wudu_purity",
          "madrasaId": "madrasa_noor_academy",
          "title": "The Light of Taharah & Step-by-Step Wudu",
          "titleUr": "طہارت کا نور اور وضو کا مسنون طریقہ",
          "subject": "fiqh",
          "ageGroup": "all",
          "content": "Purity (Taharah) is half of faith. Before we stand before Allah in Salah, we wash our hands, mouth, nose, face, arms, head, and feet with mindfulness. Every drop of water in Wudu washes away minor mistakes and brings spiritual freshness.",
          "arabicVerse": "الطُّهُورُ شَطْرُ الإِيمَانِ",
          "transliteration": "At-tuhuru shatrul-iman",
          "translation": "Purity is half of faith.",
          "points": 45,
          "createdAt": "2026-10-06",
          "createdBy": "Ustadh Farooq Al-Azhari"
        },
        {
          "id": "les_parents_respect",
          "madrasaId": "madrasa_noor_academy",
          "title": "Honoring Parents & Speaking with Gentleness",
          "titleUr": "والدین کا احترام اور باادب گفتگو",
          "subject": "akhlaq",
          "ageGroup": "all",
          "content": "In Islam, honoring parents is commanded right alongside the worship of Allah. Treating mother and father with gentleness, gratitude, and patience brings peace into the home and the highest reward in Jannah.",
          "arabicVerse": "وَقُل لَّهُمَا قَوْلًا كَرِيمًا",
          "transliteration": "Wa qul lahuma qawlan kareema",
          "translation": "And speak to them both a noble, respectful word.",
          "points": 45,
          "createdAt": "2026-10-06",
          "createdBy": "Ustadh Farooq Al-Azhari"
        },
        {
          "id": "les_seeking_ilm",
          "madrasaId": "madrasa_noor_academy",
          "title": "The Value of Seeking Knowledge in Islam",
          "titleUr": "دینی و مفید علم کی فضیلت اور طلب",
          "subject": "history",
          "ageGroup": "12-15",
          "content": "From reading the first word of Revelation \"Iqra\" to exploring science, nature, and the universe, seeking beneficial knowledge with sincere intention is an act of worship in Islam.",
          "arabicVerse": "طَلَبُ الْعِلْمِ فَرِيضَةٌ عَلَى كُلِّ مُسْلِمٍ",
          "transliteration": "Talabul-‘ilmi faridatun ‘ala kulli Muslim",
          "translation": "Seeking knowledge is an obligation upon every Muslim.",
          "points": 50,
          "createdAt": "2026-10-06",
          "createdBy": "Ustadh Farooq Al-Azhari"
        },
        {
          "id": "les_good_manners_scale",
          "madrasaId": "madrasa_noor_academy",
          "title": "The Heaviest Deed on the Scale: Good Character",
          "titleUr": "میزان پر سب سے وزنی عمل: حسنِ اخلاق",
          "subject": "akhlaq",
          "ageGroup": "9-11",
          "content": "A gentle greeting, speaking the truth, forgiving others, and controlling anger are deeds that outweigh vast mountains on the scale of deeds on the Day of Judgment.",
          "arabicVerse": "مَا مِنْ شَيْءٍ أَثْقَلُ فِي مِيزَانِ الْمُؤْمِنِ مِنْ حُسْنِ الْخُلُقِ",
          "transliteration": "Ma min shay’in athqalu fi mizani al-mu’mini min husnil-khuluq",
          "translation": "Nothing is heavier on the scale of a believer than good character.",
          "points": 45,
          "createdAt": "2026-10-06",
          "createdBy": "Ustadh Farooq Al-Azhari"
        }
